# Copy to tests/e2e.env for `tests/local_e2e.sh --real`. tests/e2e.env is git-ignored.
# Only the keys below are passed to the test container.

LLM_PROVIDER=openai-compatible
# Inside the test container, localhost is the container itself.
# For an endpoint on this machine use http://host.docker.internal:<port>/v1
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=your-model-id
LLM_API_KEY=
LLM_CONTEXT_WINDOW=128000
LLM_MAX_OUTPUT_TOKENS=
LLM_REASONING_EFFORTS=
LLM_COMPAT=
LLM_HEADERS=
LLM_SUPPORTS_IMAGES=false

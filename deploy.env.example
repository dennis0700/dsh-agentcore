# Copy to deploy.env and fill in. deploy.env is git-ignored.
AWS_REGION=cn-north-1
STACK_PREFIX=dsh-agent
AGENT_NAME=dsh_agent
REPOSITORY_NAME=dsh-agent

# Required. Never commit real keys.
# Model provider: openai-compatible (any Chat Completions endpoint) or deepseek.
LLM_PROVIDER=openai-compatible
# Base URL including the version segment; requests go to $LLM_BASE_URL/chat/completions.
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=your-model-id
# Bearer token. Leave empty for keyless gateways.
LLM_API_KEY=
# The model's real context window; automatic compaction triggers from it.
LLM_CONTEXT_WINDOW=128000
# Optional per-request output cap.
LLM_MAX_OUTPUT_TOKENS=
# Empty = non-reasoning model. Example for a model that takes reasoning_effort:
#   LLM_REASONING_EFFORTS={"off":null,"high":"high"}
LLM_REASONING_EFFORTS=
# JSON merged over the defaults {"supportsStore":false,"supportsDeveloperRole":false,"maxTokensField":"max_tokens"}.
# Examples: {"thinkingFormat":"qwen"}  {"supportsUsageInStreaming":false}  {"requiresToolResultName":true}
LLM_COMPAT=
# JSON object of extra headers, e.g. {"X-Tenant":"acme"}
LLM_HEADERS=
LLM_SUPPORTS_IMAGES=false

# Only needed for LLM_PROVIDER=deepseek, or to keep the web_search tool
# (it calls DeepSeek's search API). Leave empty otherwise.
DEEPSEEK_API_KEY=
# Used only with LLM_PROVIDER=deepseek.
DEEPSEEK_BASE_URL=
DSH_MODEL=deepseek-v4-flash
DSH_REASONING_EFFORT=
DSH_MAX_TOKENS=
DSH_PROFILE=sdk
DSH_PERMISSION_MODE=danger-full-access
DSH_UPLOAD_SESSION_LOG=false

IDLE_RUNTIME_SESSION_TIMEOUT=1800
MAX_LIFETIME=28800

# Optional mirrors for building inside mainland China.
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
APT_MIRROR=mirrors.aliyun.com
# Base image; override if Docker Hub / public ECR is unreachable from your EC2.
BASE_IMAGE=public.ecr.aws/docker/library/python:3.12-slim-bookworm
